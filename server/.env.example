# Copy to server/.env for local development.
# Keep this file on the server only; never expose it through Vite.
ANTHROPIC_API_KEY=sk-ant-your-key
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
JWT_SECRET=replace-with-a-long-random-string-at-least-32-characters
DB_PATH=server/data/chatbot.db
ALLOWED_ORIGINS=http://localhost:3000
PUBLIC_ORIGIN=
# false for direct local HTTP; true for HTTPS Preview or production.
COOKIE_SECURE=false
COOKIE_NAME=signal_room_session
MAX_HISTORY_MESSAGES=40
MAX_HISTORY_CHARACTERS=120000
NODE_ENV=development
